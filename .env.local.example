# Raahi 2.0 — Rocket/local environment template
# Copy this file to .env.local inside your environment and replace placeholders.
# NEVER commit real secrets or production credentials.

# Required: Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred for new Supabase projects
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional legacy fallback; leave blank when using the publishable key above
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Test authentication must stay OFF in Rocket/public previews unless explicitly configured for isolated staging.
RAAHI_TEST_AUTH_ENABLED=false

# Optional AI integrations — leave blank unless the feature is intentionally configured.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Intentionally NOT included here:
# SUPABASE_SERVICE_ROLE_KEY
# RAAHI_TEST_AUTH_KEY
# RAAHI_TEST_PERSONAS_JSON
# These are privileged server/staging values and should not be copied into a normal Rocket preview.
