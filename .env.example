NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Preferred for new Supabase projects:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy fallback only when needed:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required only on a dedicated Raahi staging deployment when
# automated test authentication is explicitly enabled.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RAAHI_TEST_AUTH_ENABLED=false
RAAHI_TEST_AUTH_ALLOWED_HOSTS=raahitest.example.com
RAAHI_TEST_AUTH_KEY=generate-a-long-random-secret
RAAHI_TEST_PERSONAS_JSON={"passenger-1":{"userId":"00000000-0000-0000-0000-000000000001","role":"passenger"},"driver-1":{"userId":"00000000-0000-0000-0000-000000000002","role":"driver"},"admin-1":{"userId":"00000000-0000-0000-0000-000000000003","role":"admin"}}

OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
